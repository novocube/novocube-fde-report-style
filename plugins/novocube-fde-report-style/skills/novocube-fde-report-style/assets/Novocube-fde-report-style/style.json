{
  "id": "Novocube-fde-report-style",
  "version": "1.1.0",
  "default": true,
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "showDate": false,
    "dateMode": "optional",
    "showHeader": true,
    "showPageNumbers": true,
    "headerLabel": "FDE REPORT"
  },
  "brand": {
    "displayName": "新魔方",
    "replaceLegacyNovocube": true
  },
  "colors": {
    "primary": "#174A82",
    "accent": "#1A5AA6",
    "pale": "#DCE9F7",
    "zebra": "#F5F8FC",
    "rule": "#B8CBE2",
    "text": "#162033",
    "muted": "#566173"
  },
  "typography": {
    "cjk": "Novocube Noto Sans CJK SC",
    "bundled": true,
    "files": {
      "regular": "fonts/NotoSansCJKsc-Regular.otf",
      "bold": "fonts/NotoSansCJKsc-Bold.otf",
      "license": "fonts/OFL.txt"
    },
    "fallbacks": [
      "PingFang SC",
      "Microsoft YaHei",
      "Arial",
      "sans-serif"
    ]
  }
}
